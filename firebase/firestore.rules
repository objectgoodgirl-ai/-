rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isBootstrapOwner() { return signedIn() && request.auth.token.email == 'objectgoodgirl@gmail.com'; }
    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isOwner() { return isBootstrapOwner() || hasRole('owner'); }
    function isManager() { return isOwner() || hasRole('manager'); }
    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function hasActiveInvitation() {
      return signedIn()
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.status == 'active';
    }
    function hasEmployeeRole(role) { return role in ['supervisor', 'case_lead', 'employee']; }
    function validSelfProfile() {
      return request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.role;
    }
    function leadsCase(caseId) {
      return isActiveUser()
        && exists(/databases/$(database)/documents/cases/$(caseId))
        && get(/databases/$(database)/documents/cases/$(caseId)).data.leadUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();
      allow create: if request.auth.uid == userId && (
        (isBootstrapOwner() && request.resource.data.role == 'owner' && request.resource.data.active == true)
        || (hasActiveInvitation() && validSelfProfile())
      );
      allow update: if request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt'])
        || isOwner()
        || (
          isManager()
          && !isOwner()
          && hasEmployeeRole(resource.data.role)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'displayName', 'photoURL', 'updatedAt'])
        );
      allow delete: if isOwner();
    }

    match /invitations/{email} {
      allow get: if signedIn() && (request.auth.token.email == email || isManager());
      allow list: if isManager();
      allow create, update: if isOwner()
        || (isManager() && !isOwner()
          && hasEmployeeRole(request.resource.data.role)
          && request.resource.data.email == email);
      allow delete: if isOwner();
    }

    match /cases/{caseId} {
      // 全團隊可讀案件；修改僅限管理角色或案件主負責人。
      allow get, list: if isActiveUser();
      allow create: if isManager();
      allow update: if isManager()
        || (isActiveUser()
          && resource.data.leadUid == request.auth.uid
          && request.resource.data.leadUid == resource.data.leadUid
          && request.resource.data.memberUids == resource.data.memberUids);
      allow delete: if isManager();
      match /private/{documentId} { allow read, write: if isOwner(); }
    }

    match /quotes/{quoteId} {
      allow get, list: if isActiveUser();
      allow create: if isManager() || leadsCase(request.resource.data.caseId);
      allow update: if isManager()
        || (leadsCase(resource.data.caseId)
          && request.resource.data.caseId == resource.data.caseId);
      allow delete: if isManager();
      match /private/{documentId} { allow read, write: if isOwner(); }
    }

    // 第一階段由老闆、經理集中維護人員與班表；所有啟用帳號可查閱。
    match /staffProfiles/{staffId} { allow read: if isActiveUser(); allow write: if isManager(); }
    match /assignments/{assignmentId} { allow read: if isActiveUser(); allow write: if isManager(); }
    match /leaves/{leaveId} { allow read: if isActiveUser(); allow write: if isManager(); }
    match /tasks/{taskId} { allow read: if isActiveUser(); allow write: if isManager(); }
    match /rosterOverrides/{overrideId} { allow read: if isActiveUser(); allow write: if isManager(); }
    match /settings/{settingId} { allow read: if isActiveUser(); allow write: if isManager(); }

    match /auditLogs/{logId} {
      allow read: if isManager();
      // 正式稽核紀錄改由受保護的 Cloud Function 寫入，前端不能偽造。
      allow write: if false;
    }
  }
}
